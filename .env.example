# Production Environment Variables for CORTA Stack
# Copy to .env in this directory on the server: cp .env.example .env

# Secrets (generate random long strings for these)
JWT_SECRET=generate-a-very-long-random-secret-here
COLLABORATION_SERVICE_SECRET=generate-another-random-secret-here
CURSOR_SECRET=generate-cursor-random-secret-here
AI_SERVICE_TOKEN=

# Public domains allowed by the API and realtime services.
HTTP_ALLOWED_ORIGINS=https://geeth.cf,https://www.geeth.cf,https://synodus.teshank.org,https://synodus.cse23.org
SOCKET_ALLOWED_ORIGINS=https://geeth.cf,https://www.geeth.cf,https://synodus.teshank.org,https://synodus.cse23.org

# Grafana: deploy.sh generates a password when empty; set one for local Compose.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# API tracing: sample 10% of the selected routes in production.
# Set OTEL_TRACES_ENABLED=false to disable tracing without editing Compose.
OTEL_TRACES_ENABLED=true
OTEL_TRACES_SAMPLE_RATIO=0.1
